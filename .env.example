# SamudraAI Environment Configuration
# Copy this file to .env to configure external credentials

# Google Gemini API Key (Optional: for natural language enrichment)
LLM_API_KEY=
GEMINI_API_KEY=

# India Meteorological Department (IMD) Coastal Weather API
WEATHER_API_KEY=

# National Marine Spatial GIS / Map Tile API Key (Optional)
MAP_API_KEY=

# ISRO MOSDAC Earth Observation / Oceansat-3 API Key
SATELLITE_API_KEY=

# INCOIS Ocean State Forecast & PFZ Web Services API Key
OCEAN_API_KEY=

# Platform Port Settings
PORT=8000
FRONTEND_PORT=5173
